{
    "openapi": "3.0.3",
    "info": {
        "title": "ToDo List API",
        "version": "1.0.0",
        "description": "API for managing a simple ToDo list.",
        "termsOfService": "https://example.com/terms/",
        "contact": {
            "name": "Muhammad Nevin",
            "email": "nevin.muhammad@gmail.com",
            "url": "https://github.com/MuhammadNevin"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        }
    },
    "servers": [
        {
            "url": "https://{environment}.programmerzamannow.com/api/v1",
            "description": "API Server Environment",
            "variables": {
                "environment": {
                    "default": "dev",
                    "enum": [
                        "dev",
                        "qa",
                        "prod"
                    ]
                }
            }
        }
    ],
    "externalDocs": {
        "description": "Find out more about ToDo List API",
        "url": "https://github.com/MuhammadNevin/todolist-api"
    },
    "paths": {
        "/todos": {
            "get": {
                "summary": "Get all ToDo items",
                "responses": {
                    "200": {
                        "description": "A list of ToDo items",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "Create a new ToDo item",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "ToDo item created successfully"
                    }
                }
            }
        },
        "/todos/{id}": {
            "get": {
                "summary": "Get a ToDo item by ID",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A single ToDo item",
                        "content": {
                            "application/json": {
                                "schema": {
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "ToDo item not found"
                    }
                }
            },
            "put": {
                "summary": "Update a ToDo item by ID",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "ToDo item updated successfully"
                    },
                    "404": {
                        "description": "ToDo item not found"
                    }
                }
            },
            "delete": {
                "summary": "Delete a ToDo item by ID",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "ToDo item deleted successfully"
                    },
                    "404": {
                        "description": "ToDo item not found"
                    }
                }
            }
        }
    }
}